{
  "name": "@enfyra/sdk-nuxt",
  "version": "1.0.1",
  "description": "Nuxt module for Enfyra — SSR-safe client, composables, and cookie bridge proxy",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/module.mjs",
  "module": "./dist/module.mjs",
  "types": "./dist/module.d.ts",
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@enfyra/sdk-core": "0.1.10",
    "@nuxt/kit": "^3.12.0"
  },
  "peerDependencies": {
    "nuxt": ">=3.12.0 <5"
  },
  "devDependencies": {
    "@nuxt/schema": "^3.12.0",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "unbuild": "^3.5.0",
    "vitest": "^3.0.9",
    "vue": "^3.4.0"
  }
}
